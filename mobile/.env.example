# Copy this file to .env (gitignored) and fill in real values, then run:
#   source .env && ./deploy.sh --upload
#
# App Store Connect API key — same credentials work across every app under
# your Apple Developer account, so if you already have one (e.g. from
# another project), you can reuse it here; you just need a *new app entry*
# in App Store Connect for Track Blood's bundle ID (fyi.pocha.trackblood).
#
# Create a key at: https://appstoreconnect.apple.com/access/api
#   (App Store Connect → Users and Access → Integrations → App Store Connect API)
export ASC_KEY_ID="YOUR_KEY_ID"
export ASC_ISSUER_ID="YOUR_ISSUER_ID"
export ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_YOUR_KEY_ID.p8"

# Capacitor's Android build requires JDK 21 specifically — the shell's default
# `java` may be older. Source this file before npx cap run/open android, or
# any raw ./gradlew invocation. Find your JDK 21 path with:
#   /usr/libexec/java_home -v 21
export JAVA_HOME="/path/to/jdk-21"
