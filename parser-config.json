    { "source": "^alert\\s*!", "flags": "i" },
    { "source": "^\\*?note\\s*[-–:]", "flags": "i" },
    { "source": "^clinical\\s*significance", "flags": "i" },
    { "source": "^specifications?:", "flags": "i" },
